# Origem privada usada pelo servidor Next.js para encaminhar /api/*.
# Pode ser localhost, um nome Docker ou uma URL HTTPS de outro servidor.
API_ORIGIN=http://localhost:3000

# O browser usa sempre /api/v1 na origem da Web. O destino real permanece
# apenas no servidor, em API_ORIGIN.

# Contactos apresentados ao cliente em caso de urgência.
NEXT_PUBLIC_SUPPORT_PHONE=+258 00 000 0000
NEXT_PUBLIC_SUPPORT_EMAIL=operacoes@empresa.com
NEXT_PUBLIC_DRIVER_APP_URL=https://play.google.com/store/apps/details?id=com.empresa.motorista
